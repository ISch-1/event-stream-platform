{
  "uid": "pipeline-overview",
  "title": "Pipeline — Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "tags": ["event-stream-platform"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest — request rate by type",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(esp_ingest_accepted_total[1m]))",
          "legendFormat": "{{event_type}}"
        },
        {
          "expr": "sum by (reason) (rate(esp_ingest_rejected_total[1m]))",
          "legendFormat": "rejected — {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingest latency — p95 / p99",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/events\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/events\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumer lag (raw-events)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (topic, partition) (kafka_consumer_records_lag)",
          "legendFormat": "{{topic}} / p{{partition}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ClickHouse — insert batches & rows",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(esp_sink_batches_written_total[1m])",
          "legendFormat": "batches/s"
        },
        {
          "expr": "rate(esp_sink_rows_written_total[1m])",
          "legendFormat": "rows/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DLQ — messages / 5m",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(increase(esp_dlq_written_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Sink insert p95 latency",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(esp_sink_insert_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "JVM heap used",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
